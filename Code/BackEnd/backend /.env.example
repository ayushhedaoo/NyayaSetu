# NyayaSetu V2 Backend Environment Variables

# Node Environment (development | production)
NODE_ENV=development

# Server Port
PORT=5000

# MongoDB Atlas Connection String
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/nyayasetu?retryWrites=true&w=majority

# JWT Secret for Authentication (Use a strong random string in production)
JWT_SECRET=your_jwt_secret_key_here

# JWT Expiry Time (e.g., 30d, 24h)
JWT_EXPIRE=30d

# Google Gemini API Key for AI Analysis
GEMINI_API_KEY=your_google_gemini_api_key_here

# Google Gemini Model Name
GEMINI_MODEL=gemini-flash-latest

# Allowed CORS Origins (Comma separated list of allowed frontend URLs)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
